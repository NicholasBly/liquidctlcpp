// LiquidCam - app.rc
#include <windows.h>

IDI_ICON1 ICON DISCARDABLE "app.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK  VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
 FILEFLAGS      VS_FF_DEBUG
#else
 FILEFLAGS      0x0L
#endif
 FILEOS         VOS_NT_WINDOWS32
 FILETYPE       VFT_APP
 FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "LiquidCam"
            VALUE "FileDescription",  "LiquidCam - NZXT device control"
            VALUE "FileVersion",      "1.0.0.0"
            VALUE "InternalName",     "LiquidCam"
            VALUE "LegalCopyright",   "GPL-3.0-or-later"
            VALUE "OriginalFilename", "LiquidCam.exe"
            VALUE "ProductName",      "LiquidCam"
            VALUE "ProductVersion",   "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
